# =============================================================================
# Environment Configuration - NelloreRuchullu (Conversation AI Platform)
# =============================================================================

# Environment
ENV=dev
LLM_PROVIDER=euri

# EURI API (Development)
EURI_API_KEY=your-euri-api-key-here
EURI_BASE_URL=https://api.euron.one/api/v1
EURI_MODEL=gpt-4.1-mini
EURI_EMBEDDING_MODEL=text-embedding-3-small

# Azure OpenAI (Production)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_KEY=your-azure-key-here
AZURE_DEPLOYMENT_NAME=gpt-4o
AZURE_API_VERSION=2024-02-01
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/conversation_ai
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=86400

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Security
JWT_SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Session Settings
SESSION_INACTIVITY_THRESHOLD_DAYS=7
SESSION_ARCHIVE_BATCH_SIZE=100

# Message Settings
MESSAGE_MAX_LENGTH=10000
CONTEXT_WINDOW_SIZE=20
SUMMARY_THRESHOLD_MESSAGES=50

# Attachment Settings
MAX_ATTACHMENT_SIZE_MB=10
ATTACHMENT_CLEANUP_DAYS=90
USE_LOCAL_STORAGE=true
LOCAL_STORAGE_PATH=./storage/attachments

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=your-azure-storage-connection-string-here
AZURE_STORAGE_CONTAINER_NAME=attachments

# Application
APP_NAME=Conversation AI Platform
APP_VERSION=1.0.0
DEBUG=false